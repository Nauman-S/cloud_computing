	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<!-- https://github.com/spring-projects/spring-ai/tags -->
		<spring-ai.version>1.0.0-M6</spring-ai.version>
		<java.version>21</java.version>
	</properties>
